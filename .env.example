# prloop configuration. Copy to .env and fill in.
# Only auth and a model endpoint are required; everything else has a working default.
#
# .env never overrides a variable already set in your shell. Where that bites, a
# PRR_-prefixed alternative is listed below that always wins.

# ─── Azure DevOps auth (pick one) ─────────────────────────────────────────────
# (a) PAT with Code (Read & Write) scope. In a pipeline, pass $(System.AccessToken).
# (b) Leave it empty and run `az login` instead.
PRR_ADO_PAT=

# ─── Model endpoint (OpenAI-compatible: LiteLLM proxy / vLLM / Ollama /v1) ────
PRR_LLM_BASE_URL=http://localhost:4000/v1
PRR_LLM_API_KEY=dummy
# Comma-separated. Two or more from *different model families* is what makes the
# consensus stage mean anything.
PRR_FINDER_MODELS=qwen3-coder

# ─── Adversarial verification ─────────────────────────────────────────────────
# Skeptics must be a DIFFERENT family from the finders: same-family verifiers share
# their blind spots and confirm exactly the errors that matter most.
# Leaving this empty means no verification runs — and with a single finder, nothing
# reaches an inline comment, because findings need corroboration to be published.
PRR_SKEPTIC_MODELS=

# ─── Corporate network ────────────────────────────────────────────────────────
# CA bundle to trust on a network that intercepts TLS. Comma-separated if the root and its
# intermediate came as separate files.
# Node ships its own CA list and ignores the system trust store, which is why az, curl
# and git can all work while every Node tool fails on the same machine.
#   Getting the file: browser → padlock → Certificate → Certification Path → select the
#   intermediate → export as Base64/PEM.  Or: npx tsx scripts/tlsfix.ts '<PR URL>'
PRR_CA_CERTS=
# Proxy. Node's fetch does not read HTTP(S)_PROXY by itself; prloop does. If your shell
# already exports them, leave these empty — the PRR_ names exist to override the shell.
PRR_HTTPS_PROXY=
# Internal hosts (a self-hosted model endpoint) must bypass the external proxy.
PRR_NO_PROXY=localhost,127.0.0.1
# Some proxies filter CONNECT by User-Agent. probe section 4b reports which strings pass.
PRR_USER_AGENT=

# ─── Static analysis (optional) ───────────────────────────────────────────────
# A checkout of the PR's source branch. Linters need files on disk; without this the
# static gate skips. In a pipeline this is the agent's own checkout.
PRR_WORKDIR=
# Judges high-false-positive tools (bandit / PMD / SpotBugs / eslint). Leave empty and
# those findings are dropped rather than posted unjudged.
PRR_TRIAGE_MODEL=

# ─── Publishing ───────────────────────────────────────────────────────────────
# 1 = compute everything, publish nothing. Use it on the first run against a real PR.
PRR_DRY_RUN=
# Inline comment caps. The axes have separate budgets so code findings cannot crowd out
# "this requirement was never implemented".
# PRR_MAX_INLINE_COMMENTS=10
# PRR_MAX_INLINE_REQ_COMMENTS=3
# Below this severity a finding only appears in the summary: critical|high|medium|low
# PRR_MIN_INLINE_SEVERITY=medium
# 1 = also post a PR status (needs a branch policy to actually gate merges)
# PRR_POST_STATUS=

# ─── Runner ───────────────────────────────────────────────────────────────────
# openai (default) = direct HTTP. Supports engine-level guided decoding, which is what
#                    keeps weak models emitting valid JSON.
# opencode         = via the opencode CLI, reusing its provider config. It does NOT
#                    forward response_format, so schemas drop to prompt-level only.
# PRR_RUNNER=openai
# PRR_OPENCODE_AGENT=prloop-reviewer

# ─── Rarely needed ────────────────────────────────────────────────────────────
# PRR_AUTH_MODE=auto          # auto | pat | azcli
# PRR_ADO_API_VERSION=7.1     # on-prem: Server 2019→5.0, 2020→6.0, 2022→7.0
# PRR_ADO_BASE_URL=           # only when the API host differs from the browser host
# PRR_REQ_MODEL=              # defaults to the first finder model
# PRR_SKIP_REQUIREMENT=       # 1 = skip the requirement axis
# PRR_SKIP_STATIC=            # 1 = skip static analysis
# PRR_SKEPTIC_ROUNDS=1        # 3 gives a majority vote worth the name
# PRR_REQUIRE_CORROBORATION=1 # 0 = publish single-source unverified findings
# PRR_RULES_DIR=              # defaults to the tool's own rules/
# PRR_MAX_DIFF_CHARS=240000
# PRR_LLM_STRUCTURED=1        # 0 = don't send response_format
# PRR_QUIET=
