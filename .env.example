# --- Azure DevOps 認證 ---
# 二擇一：
#   (a) PAT —— 需要 Code (Read & Write) scope；pipeline 中可改用 $(System.AccessToken)
#   (b) az CLI —— 不設 PAT，改為執行 az login，工具會自動取 token
PRR_ADO_PAT=
# auto（預設）= 有 PAT 就用 PAT，否則走 az CLI；也可強制指定 pat 或 azcli
# PRR_AUTH_MODE=auto
# PRR_AZ_BIN=az
# on-prem Azure DevOps Server 才需要改
# PRR_ADO_BASE_URL=https://dev.azure.com
# PRR_ADO_API_VERSION=7.1

# --- 模型（OpenAI 相容 endpoint：LiteLLM proxy / vLLM / Ollama /v1）---
PRR_LLM_BASE_URL=http://localhost:4000/v1
PRR_LLM_API_KEY=dummy
# M1 單一 finder；M3 起改成逗號分隔的異質模型清單
PRR_FINDER_MODELS=qwen3-coder
# PRR_LLM_TEMPERATURE=0.2
# PRR_LLM_MAX_TOKENS=8192
# PRR_LLM_TIMEOUT_MS=900000
# 後端 json_schema 支援有問題時設 0
# PRR_LLM_STRUCTURED=1

# --- diff 預算 ---
# PRR_MAX_DIFF_CHARS=240000
# PRR_HUNK_CONTEXT_BEFORE=6
# PRR_HUNK_CONTEXT_AFTER=3

# --- 發佈 ---
# 每次執行的 inline 留言上限
# PRR_MAX_INLINE_COMMENTS=10
# 低於此嚴重度不留 inline 留言：critical|high|medium|low
# PRR_MIN_INLINE_SEVERITY=medium
# 1 = 只計算不發佈（第一次對真實 PR 執行時建議開啟）
# PRR_DRY_RUN=1
# 1 = 同時回報 PR status（需搭配 branch policy 才會擋 merge）
# PRR_POST_STATUS=0
# PRR_STATUS_GENRE=prloop
# PRR_STATUS_NAME=ai-review

# PRR_QUIET=0

# --- 審查軸 ---
# 需求軸模型。未設時沿用第一顆 finder 模型
# PRR_REQ_MODEL=
# 1 = 跳過需求軸
# PRR_SKIP_REQUIREMENT=0
# 1 = PR 未連結 work item 時視為失敗（預設只警告）
# PRR_REQUIRE_WORK_ITEM=0
# 需求軸的 inline 留言上限（與程式碼軸各自獨立，不互相排擠）
# PRR_MAX_INLINE_REQ_COMMENTS=3

# --- 審查規則 ---
# 規則目錄，預設為工具內的 rules/
# PRR_RULES_DIR=

# --- Runner ---
# openai（預設）= 直接打 OpenAI 相容 endpoint，支援 guided decoding（schema 由引擎強制）
# opencode      = 透過 opencode CLI，沿用其 provider 設定
#                 注意：opencode 不會傳遞 response_format，schema 只能靠 prompt 約束
# PRR_RUNNER=openai
# PRR_OPENCODE_BIN=opencode
# PRR_OPENCODE_AGENT=prloop-reviewer
# PRR_OPENCODE_JSON=1
# PRR_AGENT_TIMEOUT_MS=900000

# --- 對抗驗證（M3）---
# skeptic 模型，逗號分隔。務必與 finder 用「不同家族」的模型
PRR_SKEPTIC_MODELS=
# 每筆 finding 的驗證輪數。1 = 單一關卡，3 = 有意義的多數決
# PRR_SKEPTIC_ROUNDS=1
# 給 skeptic 看的上下文行數（前後各幾行）
# PRR_SKEPTIC_CONTEXT_LINES=25
# 幾個模型獨立發現才算有佐證
# PRR_MIN_CONSENSUS_SOURCES=2
# 0 = 允許單一模型且未驗證的 findings 直接留言（較寬鬆、較吵）
# PRR_REQUIRE_CORROBORATION=1
