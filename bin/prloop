#!/usr/bin/env bash
# Wrapper so prloop can be run from any directory.
set -euo pipefail
TOOL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# prloop applies PRR_CA_CERTS itself (libs/tls.ts attaches it to the HTTP dispatcher), so
# this block is not what makes the tool's own requests work. It exists for the child
# processes — opencode, az, git — which have their own HTTP stacks and only read the
# environment. Precedence:
#   1. NODE_EXTRA_CA_CERTS already in the environment
#   2. PRR_CA_CERTS from .env (the place to put a corporate CA)
#   3. whatever bundle the rest of the toolchain already trusts. Node ships its own CA list
#      and ignores the system store, which is why az/curl/git can work on a TLS-intercepting
#      network while every Node tool fails on the same machine.
if [ -z "${NODE_EXTRA_CA_CERTS:-}" ]; then
  if [ -z "${PRR_CA_CERTS:-}" ] && [ -f "$TOOL_DIR/.env" ]; then
    PRR_CA_CERTS="$(sed -n 's/^[[:space:]]*PRR_CA_CERTS[[:space:]]*=[[:space:]]*//p' "$TOOL_DIR/.env" \
      | tail -1 | sed 's/^["'\'']//; s/["'\'']$//')"
  fi
  for candidate in "${PRR_CA_CERTS:-}" "${REQUESTS_CA_BUNDLE:-}" "${SSL_CERT_FILE:-}" "${CURL_CA_BUNDLE:-}"; do
    if [ -n "$candidate" ] && [ -r "$candidate" ]; then
      export NODE_EXTRA_CA_CERTS="$candidate"
      break
    fi
  done
fi

exec npx tsx "$TOOL_DIR/loop.ts" "$@"
